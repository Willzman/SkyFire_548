[Unit]
Description=SkyFire feedback GitHub worker (tools/feedback/feedback_worker.py)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=william
WorkingDirectory=/home/william/skyfire/feedback/app
ExecStart=/usr/bin/python3 -E -s feedback_worker.py --config /home/william/skyfire/feedback/feedback.conf
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/william/skyfire/feedback

[Install]
WantedBy=multi-user.target
